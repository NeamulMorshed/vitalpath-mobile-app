// ═════════════════════════════════════════════════════════════════════════════
// VitalPath — Cloud Firestore Security Rules  v2.1
//
// RBAC Architecture:
//   Roles are carried as Firebase Auth CUSTOM CLAIMS (request.auth.token.role).
//   Custom claims are set server-side by a Cloud Function on user creation:
//     admin.auth().setCustomUserClaims(uid, { role: 'patient' | 'doctor' | ... })
//
//   IMPORTANT: DO NOT use document-level role reads (get(...).data.role) for
//   primary role enforcement — that adds one Firestore read per rule evaluation
//   and will push latency above the 100ms SLA. Custom claims are embedded in
//   the signed JWT, evaluated in-memory with zero additional I/O.
//
//   Valid roles: "patient" | "doctor" | "caregiver" | "admin"
//
// Clinical Lock:
//   Any document with is_verified == true is immutable to patients.
//   Only Cloud Functions (Admin SDK) may set is_verified / governance_level.
//   Doctors may amend their own verified records directly.
//
// Encryption metadata:
//   All health documents may include an 'enc_version' field (integer) tracking
//   the AES-256 encryption key version used for sensitive fields. This field is
//   treated as non-clinical metadata and is always writable by the document owner.
//
// GDPR / Right to be Forgotten:
//   Deletion is handled by the 'deleteAccount' Cloud Function (Admin SDK).
//   Patients signal intent by writing to /data_deletion_requests/{userId}.
//   The Cloud Function wipes all subcollections, the user document, and the
//   Firebase Auth account. The client never deletes subcollections directly.
//
// Privacy Audit Log:
//   /users/{userId}/privacy_audit_log/{entryId}
//   Written EXCLUSIVELY by Cloud Functions when doctors read or write clinical data.
//   Patients have read-only access to their own audit log.
//
// Testing:
//   firebase emulators:start --only firestore
//   firebase emulators:exec --only firestore "npm run test:rules"
// ═════════════════════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS — ZERO ADDITIONAL FIRESTORE READS
    // All role checks use signed JWT custom claims (request.auth.token.*).
    // ─────────────────────────────────────────────────────────────────────────

    /// True when the request carries a valid Firebase Auth token.
    function isAuthenticated() {
      return request.auth != null;
    }

    /// The caller's Firebase UID.
    function callerUid() {
      return request.auth.uid;
    }

    /// Role from the signed JWT custom claim — zero Firestore I/O.
    /// Set server-side: admin.auth().setCustomUserClaims(uid, { role: 'patient' })
    function callerRole() {
      return request.auth.token.get('role', '');
    }

    /// True when the caller holds the 'doctor' role.
    function isDoctor() {
      return isAuthenticated() && callerRole() == 'doctor';
    }

    /// True when the caller holds the 'patient' role.
    function isPatient() {
      return isAuthenticated() && callerRole() == 'patient';
    }

    /// True when the caller holds the 'admin' role.
    function isAdmin() {
      return isAuthenticated() && callerRole() == 'admin';
    }

    /// True when the caller holds the 'caregiver' role.
    function isCaregiver() {
      return isAuthenticated() && callerRole() == 'caregiver';
    }

    // ── Ownership ─────────────────────────────────────────────────────────────

    /// True when the caller's UID matches the userId path segment.
    function isOwner(userId) {
      return isAuthenticated() && callerUid() == userId;
    }

    // ── Relationship guards (one Firestore read each — used sparingly) ─────────

    /// True when the calling doctor is linked to this patient.
    /// This read is acceptable because it gates clinical write access, not reads.
    function isLinkedDoctor(userId) {
      return isDoctor() &&
             exists(/databases/$(database)/documents/users/$(userId)/linked_doctors/$(callerUid()));
    }

    /// True when the calling caregiver is listed under this patient.
    function isLinkedCaregiver(userId) {
      return isCaregiver() &&
             exists(/databases/$(database)/documents/users/$(userId)/caregivers/$(callerUid()));
    }

    // ── Clinical Lock helpers ──────────────────────────────────────────────────

    /// True when the stored document carries the Clinical Lock (is_verified = true).
    function isVerifiedRecord() {
      return resource != null && resource.data.get('is_verified', false) == true;
    }

    /// Blocks any client attempt to self-promote governance fields.
    /// ONLY Cloud Functions (Admin SDK) may write is_verified or governance_level.
    function isAttemptingVerificationPromotion() {
      return request.resource.data.keys().hasAny(['is_verified', 'governance_level']);
    }

    /// Encryption metadata field — always allowed alongside data fields.
    /// enc_version tracks which AES-256 key version was used for sensitive fields.
    function isEncryptionMetadataOnly(affectedKeys) {
      return affectedKeys.hasOnly(['enc_version']);
    }

    // ── Field-level update guards ──────────────────────────────────────────────

    /// Keys actually changed by this write (excludes unchanged fields).
    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }


    // ─────────────────────────────────────────────────────────────────────────
    // USER PROFILES
    // /users/{userId}
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {

      /// Patients read their own; doctors/admins can read for clinical workflows.
      allow read: if isOwner(userId) || isDoctor() || isAdmin();

      /// Self-creation on sign-up. Role is set by Cloud Function via custom claims
      /// — the document role field is secondary, custom claim is authoritative.
      allow create: if isOwner(userId) && isAuthenticated() &&
                       // Prevent self-assigning privileged roles on account creation.
                       request.resource.data.get('role', 'patient') == 'patient';

      /// Owner may update their profile, but NOT their own 'role' field.
      /// Role transitions (patient → caregiver) are admin-only Cloud Function ops.
      allow update: if isOwner(userId) &&
                       !affectedKeys().hasAny(['role']) &&
                       // GDPR deletion_requested flag is the ONLY way a patient can
                       // mark their account for deletion — the Cloud Function handles the wipe.
                       (affectedKeys().hasOnly(['deletion_requested', 'deletion_requested_at',
                                                'display_name', 'avatar_url', 'timezone_preference',
                                                'biometric_enabled', 'enc_version']) ||
                        isAdmin());

      /// Patients CANNOT delete their own document. The 'deleteAccount' Cloud
      /// Function wipes everything after verifying the deletion_requested flag.
      allow delete: if isAdmin();
    }


    // ─────────────────────────────────────────────────────────────────────────
    // PRESCRIPTIONS  — Clinical Lock
    // /users/{userId}/prescriptions/{prescriptionId}
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/prescriptions/{prescriptionId} {

      allow read: if isOwner(userId) ||
                     isLinkedDoctor(userId) ||
                     isLinkedCaregiver(userId) ||
                     isAdmin();

      /// Patients may create self-managed prescriptions.
      /// Linked doctors may create verified prescriptions (via app SDK).
      /// is_verified / governance_level must go through Cloud Function.
      allow create: if (isOwner(userId) && !isAttemptingVerificationPromotion()) ||
                       isLinkedDoctor(userId) ||
                       isAdmin();

      /// THE CLINICAL LOCK UPDATE GATE:
      ///   Unverified → patient can edit (but not promote governance fields).
      ///   Verified → ONLY the linked doctor or admin may edit.
      allow update: if (
                        !isVerifiedRecord() &&
                        isOwner(userId) &&
                        !isAttemptingVerificationPromotion()
                       ) ||
                       (
                        isVerifiedRecord() &&
                        (isLinkedDoctor(userId) || isAdmin())
                       );

      /// Patients can delete ONLY their own unverified records.
      /// Verified records require a linked doctor or admin.
      allow delete: if (!isVerifiedRecord() && isOwner(userId)) ||
                       (isVerifiedRecord() && (isLinkedDoctor(userId) || isAdmin()));
    }


    // ─────────────────────────────────────────────────────────────────────────
    // MEDICINE LOGS  — Dose records (written by patient, audited)
    // /users/{userId}/medicine_logs/{logId}
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/medicine_logs/{logId} {

      /// Patient reads their own. Linked doctor reads for adherence review.
      allow read: if isOwner(userId) || isLinkedDoctor(userId) || isAdmin();

      /// Patient creates dose logs (via MedicineLoggingService).
      /// Logs are append-only — patients cannot retroactively alter their log.
      allow create: if isOwner(userId) && isAuthenticated();

      /// Medicine logs are immutable after creation.
      /// Only admin may update (e.g., correcting a system error).
      allow update: if isAdmin();

      /// Patients cannot delete dose logs (audit trail integrity).
      /// Admin can delete erroneous entries.
      allow delete: if isAdmin();
    }


    // ─────────────────────────────────────────────────────────────────────────
    // NUTRITION LOGS  — Clinical Lock
    // /users/{userId}/nutrition_logs/{logId}
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/nutrition_logs/{logId} {

      allow read: if isOwner(userId) ||
                     isLinkedDoctor(userId) ||
                     isLinkedCaregiver(userId) ||
                     isAdmin();

      allow create: if (isOwner(userId) && !isAttemptingVerificationPromotion()) ||
                       isLinkedDoctor(userId) ||
                       isAdmin();

      allow update: if (
                        !isVerifiedRecord() &&
                        isOwner(userId) &&
                        !isAttemptingVerificationPromotion()
                       ) ||
                       (isVerifiedRecord() && (isLinkedDoctor(userId) || isAdmin()));

      allow delete: if (!isVerifiedRecord() && isOwner(userId)) ||
                       (isVerifiedRecord() && (isLinkedDoctor(userId) || isAdmin()));
    }


    // ─────────────────────────────────────────────────────────────────────────
    // ACTIVITY LOGS  — Modified Clinical Lock: patients CAN toggle is_completed
    // /users/{userId}/activity_logs/{logId}
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/activity_logs/{logId} {

      allow read: if isOwner(userId) ||
                     isLinkedDoctor(userId) ||
                     isLinkedCaregiver(userId) ||
                     isAdmin();

      allow create: if (isOwner(userId) && !isAttemptingVerificationPromotion()) ||
                       isLinkedDoctor(userId) ||
                       isAdmin();

      allow update: if (
                        // Unverified — patient edits freely (cannot promote governance).
                        !isVerifiedRecord() &&
                        isOwner(userId) &&
                        !isAttemptingVerificationPromotion()
                       ) ||
                       (
                        // Verified adherence toggle — patient marks prescribed activity done.
                        // Only is_completed may change; all clinical fields stay locked.
                        isVerifiedRecord() &&
                        isOwner(userId) &&
                        affectedKeys().hasOnly(['is_completed', 'enc_version'])
                       ) ||
                       (
                        // Doctor or admin full update.
                        isVerifiedRecord() &&
                        (isLinkedDoctor(userId) || isAdmin())
                       );

      allow delete: if (!isVerifiedRecord() && isOwner(userId)) ||
                       (isVerifiedRecord() && (isLinkedDoctor(userId) || isAdmin()));
    }


    // ─────────────────────────────────────────────────────────────────────────
    // GPS WALK SESSIONS  — PHI: encrypted routePoints
    // /users/{userId}/walk_sessions/{sessionId}
    //
    // routePoints contain lat/lng coordinates — health-sensitive spatial data.
    // Client writes AES-256-encrypted routePoints before Firestore write.
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/walk_sessions/{sessionId} {

      allow read: if isOwner(userId) || isLinkedDoctor(userId) || isAdmin();

      /// Patient creates walk sessions.
      allow create: if isOwner(userId) && isAuthenticated();

      /// Patient may update their own session (e.g., archiving GPS path to bounding box).
      allow update: if isOwner(userId) ||
                       (isLinkedDoctor(userId) && !affectedKeys().hasAny(['route_points'])) ||
                       isAdmin();

      /// Patients can delete their own walk sessions (no clinical lock on these).
      allow delete: if isOwner(userId) || isAdmin();
    }


    // ─────────────────────────────────────────────────────────────────────────
    // APPOINTMENTS
    // /users/{userId}/appointments/{appointmentId}
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/appointments/{appointmentId} {

      allow read: if isOwner(userId) || isLinkedDoctor(userId) || isAdmin();

      allow create: if isOwner(userId) && isAuthenticated();

      /// Doctor: full lifecycle management (confirm, reschedule, add notes).
      /// Patient: can only set status → 'cancelled'. Cannot modify clinical fields.
      /// Server-side timestamp wins on concurrent edits (handled by Cloud Function).
      allow update: if isLinkedDoctor(userId) ||
                       isAdmin() ||
                       (
                         isOwner(userId) &&
                         affectedKeys().hasOnly(['status']) &&
                         request.resource.data.status == 'cancelled'
                       );

      allow delete: if isOwner(userId) || isLinkedDoctor(userId) || isAdmin();
    }


    // ─────────────────────────────────────────────────────────────────────────
    // LINKED DOCTORS  — Sync relationship registry
    // /users/{userId}/linked_doctors/{doctorId}
    //
    // Each document holds sync status, synced_at, and doctor metadata.
    // The patient manages their own doctor list.
    // Doctors can read their own link record (to verify patient consent).
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/linked_doctors/{doctorId} {

      allow read: if isOwner(userId) ||
                     (isDoctor() && callerUid() == doctorId) ||
                     isAdmin();

      /// Patient writes (add/remove doctor from their list).
      allow write: if isOwner(userId) || isAdmin();
    }


    // ─────────────────────────────────────────────────────────────────────────
    // CAREGIVERS
    // /users/{userId}/caregivers/{caregiverId}
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/caregivers/{caregiverId} {

      allow read: if isOwner(userId) ||
                     (isCaregiver() && callerUid() == caregiverId) ||
                     isAdmin();

      allow write: if isOwner(userId) || isAdmin();
    }


    // ─────────────────────────────────────────────────────────────────────────
    // PRIVACY AUDIT LOG  — Immutable, written by Cloud Functions only
    // /users/{userId}/privacy_audit_log/{entryId}
    //
    // Schema per document:
    //   event_type:          string  ("doctor_read" | "doctor_write" | "sync_connected" | ...)
    //   actor_id:            string  (doctor UID who triggered the event)
    //   actor_name:          string  (doctor display name)
    //   actor_role:          string  ("doctor" | "caregiver" | "admin")
    //   affected_collection: string  ("prescriptions" | "appointments" | ...)
    //   affected_doc_id:     string? (document ID, if applicable)
    //   timestamp:           timestamp (server-side only)
    //   details:             string? (human-readable summary)
    //   ip_address:          string? (captured server-side, never from client)
    //
    // Patients can READ their own audit log (transparency).
    // WRITES come exclusively from Cloud Functions (Admin SDK bypasses rules).
    // No client (patient, doctor, or caregiver) may write entries.
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/privacy_audit_log/{entryId} {

      /// Patients view their own transparency log.
      allow read: if isOwner(userId) || isAdmin();

      /// No client writes — Cloud Functions use Admin SDK which bypasses rules.
      allow write: if false;
    }


    // ─────────────────────────────────────────────────────────────────────────
    // GDPR DATA DELETION REQUESTS
    // /data_deletion_requests/{userId}
    //
    // Patient writes a deletion request document. The 'deleteAccount' Cloud
    // Function watches this collection and executes the full wipe asynchronously:
    //   1. Deletes all patient subcollections (prescriptions, logs, sessions, etc.)
    //   2. Deletes the /users/{userId} document
    //   3. Deletes the Firebase Auth account
    //   4. Writes a tombstone to /deletion_audit/{userId} (GDPR compliance record)
    //
    // This design is necessary because clients cannot delete Firestore subcollections
    // directly — only the Admin SDK can enumerate and delete subcollections atomically.
    // ─────────────────────────────────────────────────────────────────────────
    match /data_deletion_requests/{userId} {

      /// Patient reads their own pending request (to check status).
      allow read: if isOwner(userId) || isAdmin();

      /// Patient creates their own deletion request.
      /// Required fields: requested_at (timestamp), reason (string), confirmed (bool).
      allow create: if isOwner(userId) &&
                       request.resource.data.keys().hasAll(['requested_at', 'confirmed']) &&
                       request.resource.data.confirmed == true;

      /// Deletion requests are immutable after creation.
      /// Only admin (or Cloud Function) may update status fields.
      allow update: if isAdmin();

      /// Requests are deleted by the Cloud Function once processed.
      allow delete: if isAdmin();
    }


    // ─────────────────────────────────────────────────────────────────────────
    // DOCTORS DIRECTORY
    // /doctors/{doctorId}
    //
    // Public-read (authenticated only) for sync code validation.
    // All writes via Admin SDK on doctor onboarding.
    // ─────────────────────────────────────────────────────────────────────────
    match /doctors/{doctorId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }


    // ─────────────────────────────────────────────────────────────────────────
    // DEFAULT DENY — everything not explicitly matched above is blocked.
    // ─────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
